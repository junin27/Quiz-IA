# Conexão com pooling do Supabase (usado em tempo de execução)
DATABASE_URL="postgresql://postgres.[REFERENCIA_DO_SUPABASE]:[SUA_SENHA]@aws-1-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexão direta do Supabase (usado para migrations do Prisma)
DIRECT_URL="postgresql://postgres.[REFERENCIA_DO_SUPABASE]:[SUA_SENHA]@aws-1-us-east-1.pooler.supabase.com:5432/postgres"

# Configurações do Supabase no Front-end (Realtime/Auth)
VITE_SUPABASE_URL="https://[REFERENCIA_DO_SUPABASE].supabase.co"
VITE_SUPABASE_ANON_KEY="[SUA_CHAVE_ANON_DO_SUPABASE]"

# Hash bcrypt da senha de administrador do leaderboard
# Gere com: node -e "const b=require('bcryptjs'); b.hash('sua-senha',10).then(console.log)"
VITE_ADMIN_PASSWORD_HASH="[HASH_BCRYPT_DA_SENHA_ADMIN]"

# Modo Feira (true = login simplificado sem e-mail)
VITE_FAIR_MODE="false"

# Chave de API global padrão para o modo Feira (opcional)
VITE_DEFAULT_API_KEY=""

# Origens permitidas para requisições de CORS na API (separadas por vírgula)
# No desenvolvimento local, inclua: http://localhost:5173,http://127.0.0.1:5173
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,https://seu-app.vercel.app"
